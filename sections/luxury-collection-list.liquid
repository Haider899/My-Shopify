<section class="lb-collection-list">
  <div class="lb-container">
    <header class="lb-collection__header">
      <p class="lb-eyebrow">{{ section.settings.eyebrow | default: 'Browse' }}</p>
      <h1 class="lb-heading lb-collection__title">{{ section.settings.heading | default: 'All Collections' }}</h1>
      <p class="lb-text lb-collection__description">{{ section.settings.description | default: 'Discover our curated categories of premium products.' }}</p>
    </header>

    <div class="lb-grid lb-grid--collections">
      {% for collection in collections %}
        {% if collection.handle != 'frontpage' and collection.handle != 'all' %}
          <a class="lb-collection-card" href="{{ collection.url }}">
            <div class="lb-collection-card__media">
              {% if collection.image %}
                {{ collection.image | image_url: width: 900 | image_tag: class: 'lb-collection-card__img', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(max-width: 767px) 92vw, (max-width: 1023px) 46vw, 30vw', alt: collection.title }}
              {% elsif collection.products.first and collection.products.first.featured_image %}
                {{ collection.products.first.featured_image | image_url: width: 900 | image_tag: class: 'lb-collection-card__img', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(max-width: 767px) 92vw, (max-width: 1023px) 46vw, 30vw', alt: collection.title }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'lb-collection-card__img' }}
              {% endif %}
              <div class="lb-collection-card__overlay">
                <span class="lb-btn lb-btn--ghost lb-collection-card__cta">Explore</span>
              </div>
            </div>
            <div class="lb-collection-card__body">
              <h2 class="lb-collection-card__title">{{ collection.title }}</h2>
              <p class="lb-collection-card__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our curated categories of premium products."
    }
  ],
  "presets": [
    {
      "name": "Collection List"
    }
  ]
}
{% endschema %}
