<section class="lb-faq">
  <div class="lb-container">
    <div class="lb-related__head">
      <div>
        <p class="lb-eyebrow">Need Help?</p>
        <h2 class="lb-heading" style="margin:0.35rem 0 0; font-size: clamp(1.4rem, 4vw, 2rem);">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <div class="lb-faq__list">
      {% for block in section.blocks %}
        <details class="lb-faq__item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="lb-text">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take in Pakistan?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Most orders are delivered within 2-5 business days depending on city."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Do you offer returns or exchanges?", "answer": "Yes, we offer a 7-day exchange policy for eligible products." } },
        { "type": "faq", "settings": { "question": "Are your perfumes and jewelry authentic?", "answer": "Yes. Every item in our store is carefully curated and quality-checked before dispatch." } }
      ]
    }
  ]
}
{% endschema %}
