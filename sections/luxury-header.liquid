{% liquid
  assign fragrances_menu = linklists[section.settings.fragrances_menu]
  assign jewelry_menu = linklists[section.settings.jewelry_menu]
  assign garments_menu = linklists[section.settings.garments_menu]
  assign arrivals_menu = linklists[section.settings.arrivals_menu]
  assign all_products_url = routes.all_products_collection_url

  assign perfumes_col = collections[section.settings.perfumes_collection]
  assign jewelry_col = collections[section.settings.jewelry_collection]
  assign garments_col = collections[section.settings.garments_collection]
  assign arrivals_col = collections[section.settings.arrivals_collection]

  if perfumes_col != blank
    assign perfumes_url = perfumes_col.url
  else
    assign perfumes_url = all_products_url
  endif

  if jewelry_col != blank
    assign jewelry_url = jewelry_col.url
  else
    assign jewelry_url = all_products_url
  endif

  if garments_col != blank
    assign garments_url = garments_col.url
  else
    assign garments_url = all_products_url
  endif

  if arrivals_col != blank
    assign arrivals_url = arrivals_col.url
  else
    assign arrivals_url = all_products_url
  endif
%}



<header class="lb-header" data-lb-header>
  <div class="lb-container lb-header__inner">
    <a class="lb-brand" href="{{ routes.root_url }}">{{ section.settings.brand_label | escape }}</a>

    <nav class="lb-nav" aria-label="Main navigation">
      <div class="lb-nav__categories">
        <div class="lb-nav__item">
          <a class="lb-nav__trigger lb-nav__chip" href="{{ perfumes_url }}">Girls Perfume</a>
          <div class="lb-mega" role="menu" aria-label="Perfume menu">
            <div class="lb-mega__grid">
              <div>
                <h3 class="lb-mega__title">Signature Perfumes</h3>
                <ul class="lb-mega__list">
                  {% for link in fragrances_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% else %}
                    <li><a href="{{ perfumes_url }}">All Perfumes</a></li>
                  {% endfor %}
                </ul>
              </div>
              <div>
                <h3 class="lb-mega__title">Curated</h3>
                <ul class="lb-mega__list">
                  <li><a href="{{ perfumes_url }}">Bestsellers</a></li>
                  <li><a href="{{ perfumes_url }}">Premium Collection</a></li>
                  <li><a href="{{ perfumes_url }}">Evening Luxe</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="lb-nav__item">
          <a class="lb-nav__trigger lb-nav__chip" href="{{ jewelry_url }}">Jewelry</a>
          <div class="lb-mega" role="menu" aria-label="Jewelry menu">
            <div class="lb-mega__grid">
              <div>
                <h3 class="lb-mega__title">Handcrafted Jewelry</h3>
                <ul class="lb-mega__list">
                  {% for link in jewelry_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% else %}
                    <li><a href="{{ jewelry_url }}">Necklaces</a></li>
                    <li><a href="{{ jewelry_url }}">Earrings</a></li>
                    <li><a href="{{ jewelry_url }}">Bracelets</a></li>
                  {% endfor %}
                </ul>
              </div>
              <div>
                <h3 class="lb-mega__title">Style Edit</h3>
                <ul class="lb-mega__list">
                  <li><a href="{{ jewelry_url }}">Party Edit</a></li>
                  <li><a href="{{ jewelry_url }}">Daily Glam</a></li>
                  <li><a href="{{ jewelry_url }}">Gift Picks</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="lb-nav__item">
          <a class="lb-nav__trigger lb-nav__chip" href="{{ garments_url }}">Garments</a>
          <div class="lb-mega" role="menu" aria-label="Garments menu">
            <div class="lb-mega__grid">
              <div>
                <h3 class="lb-mega__title">Women Fashion</h3>
                <ul class="lb-mega__list">
                  {% for link in garments_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% else %}
                    <li><a href="{{ garments_url }}">Abayas</a></li>
                    <li><a href="{{ garments_url }}">Kurtas</a></li>
                    <li><a href="{{ garments_url }}">Co-ord Sets</a></li>
                  {% endfor %}
                </ul>
              </div>
              <div>
                <h3 class="lb-mega__title">By Occasion</h3>
                <ul class="lb-mega__list">
                  <li><a href="{{ garments_url }}">Wedding Guest</a></li>
                  <li><a href="{{ garments_url }}">Office Chic</a></li>
                  <li><a href="{{ garments_url }}">Weekend Luxe</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="lb-nav__item lb-nav__item--arrival">
          <a class="lb-nav__trigger lb-nav__chip" href="{{ arrivals_url }}">New Arrivals</a>
          <div class="lb-mega" role="menu" aria-label="New arrivals menu">
            <div class="lb-mega__grid">
              <div>
                <h3 class="lb-mega__title">New Fashion</h3>
                <ul class="lb-mega__list">
                  {% for link in arrivals_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% else %}
                    <li><a href="{{ arrivals_url }}">New This Week</a></li>
                  {% endfor %}
                </ul>
              </div>
              <div>
                <h3 class="lb-mega__title">Trending Now</h3>
                <ul class="lb-mega__list">
                  <li><a href="{{ arrivals_url }}">Editors Choice</a></li>
                  <li><a href="{{ arrivals_url }}">Most Wanted</a></li>
                  <li><a href="{{ arrivals_url }}">Limited Pieces</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <div class="lb-header__actions">
      <a class="lb-header__search-link" href="{{ routes.search_url }}" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>

      <button class="lb-cart-toggle" type="button" data-lb-cart-toggle aria-label="Open cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 7H22L20.5 16H8.5L7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M7 7L6.3 4.8C6.1 4.1 5.5 3.6 4.8 3.6H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="10" cy="20" r="1.2" fill="currentColor"/>
          <circle cx="18" cy="20" r="1.2" fill="currentColor"/>
        </svg>
        <span class="lb-cart-toggle__count" data-lb-cart-count>{{ cart.item_count }}</span>
      </button>

      <button class="lb-mobile-toggle" type="button" aria-expanded="false" aria-controls="lb-mobile-drawer" data-lb-mobile-toggle>
        <span class="visually-hidden">Open menu</span>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="lb-mobile-drawer" id="lb-mobile-drawer" data-lb-mobile-drawer>
    <div class="lb-container">
      <details>
        <summary>Fragrances</summary>
        <ul>
          {% for link in fragrances_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% else %}
            <li><a href="{{ perfumes_url }}">All Perfumes</a></li>
          {% endfor %}
        </ul>
      </details>
      <details>
        <summary>Jewelry</summary>
        <ul>
          {% for link in jewelry_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% else %}
            <li><a href="{{ jewelry_url }}">All Jewelry</a></li>
          {% endfor %}
        </ul>
      </details>
      <details>
        <summary>Garments</summary>
        <ul>
          {% for link in garments_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% else %}
            <li><a href="{{ garments_url }}">All Garments</a></li>
          {% endfor %}
        </ul>
      </details>
      <details>
        <summary>New Arrivals</summary>
        <ul>
          {% for link in arrivals_menu.links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% else %}
            <li><a href="{{ arrivals_url }}">All New Arrivals</a></li>
          {% endfor %}
        </ul>
      </details>
      <div class="lb-mobile-drawer__extra">
        <a href="{{ routes.search_url }}">Search</a>
        <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Luxury Header Mega Menu",
  "settings": [
    {
      "type": "text",
      "id": "brand_label",
      "label": "Brand label",
      "default": "Zareen Muse"
    },
    {
      "type": "collection",
      "id": "perfumes_collection",
      "label": "Perfumes collection (direct link)"
    },
    {
      "type": "collection",
      "id": "jewelry_collection",
      "label": "Jewelry collection (direct link)"
    },
    {
      "type": "collection",
      "id": "garments_collection",
      "label": "Garments collection (direct link)"
    },
    {
      "type": "collection",
      "id": "arrivals_collection",
      "label": "New Arrivals collection (direct link)"
    },
    {
      "type": "link_list",
      "id": "fragrances_menu",
      "label": "Fragrances mega menu"
    },
    {
      "type": "link_list",
      "id": "jewelry_menu",
      "label": "Jewelry mega menu"
    },
    {
      "type": "link_list",
      "id": "garments_menu",
      "label": "Garments mega menu"
    },
    {
      "type": "link_list",
      "id": "arrivals_menu",
      "label": "New Arrivals mega menu"
    }
  ],
  "presets": [
    {
      "name": "Luxury Header Mega Menu"
    }
  ]
}
{% endschema %}

