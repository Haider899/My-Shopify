{% liquid
  assign featured_collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show
%}


<section class="lb-hero">
  <div class="lb-container">
    <div class="lb-hero__grid">
      <div class="lb-hero__image-wrap">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1800 | image_tag: class: 'lb-hero__image', loading: 'lazy', widths: '480, 768, 1024, 1440, 1800', sizes: '(max-width: 767px) 92vw, 56vw', alt: section.settings.hero_title }}
        {% else %}
          {{ 'zareen-hero-ultra-hd.svg' | asset_url | image_tag: class: 'lb-hero__image', loading: 'lazy', alt: section.settings.hero_title }}
        {% endif %}
      </div>
      <div class="lb-hero__content">
        <p class="lb-eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="lb-heading lb-hero__title">{{ section.settings.hero_title }}</h1>
        <p class="lb-text lb-hero__description">{{ section.settings.hero_text }}</p>
        <a class="lb-btn" href="{{ section.settings.hero_cta_url }}">{{ section.settings.hero_cta_label }}</a>
      </div>
    </div>
  </div>
</section>

<section class="lb-featured-products">
  <div class="lb-container">
    <div class="lb-related__head">
      <div>
        <p class="lb-eyebrow">Curated Picks</p>
        <h2 class="lb-heading" style="margin:0.35rem 0 0; font-size: clamp(1.4rem, 4vw, 2rem);">{{ section.settings.grid_title }}</h2>
      </div>
      {% if featured_collection != blank %}
        <a class="lb-btn lb-btn--ghost" href="{{ featured_collection.url }}">Explore All</a>
      {% endif %}
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="lb-grid {% if section.settings.grid_style == 'masonry' %}lb-grid--masonry{% endif %}">
        {% for product in featured_collection.products limit: products_to_show %}
          <article class="lb-product-card">
            <a class="lb-product-card__media" href="{{ product.url }}">
              {% assign primary_image = product.featured_image %}
              {% assign secondary_image = product.images[1] %}

              {% if primary_image %}
                {{ primary_image | image_url: width: 900 | image_tag: class: 'lb-product-card__img lb-product-card__img--primary', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(max-width: 767px) 46vw, (max-width: 1023px) 30vw, 22vw', alt: product.title }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'lb-product-card__img lb-product-card__img--primary' }}
              {% endif %}

              {% if secondary_image %}
                {{ secondary_image | image_url: width: 900 | image_tag: class: 'lb-product-card__img lb-product-card__img--secondary', loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(max-width: 767px) 46vw, (max-width: 1023px) 30vw, 22vw', alt: product.title }}
              {% endif %}
            </a>

            <button
              class="lb-product-card__quick"
              type="button"
              data-lb-quick-view
              data-product-title="{{ product.title | escape }}"
              data-product-price="{{ product.price | money }}"
              data-product-image="{{ primary_image | image_url: width: 900 }}"
              data-product-url="{{ product.url }}"
              aria-label="Quick view {{ product.title | escape }}"
            >
              Quick View
            </button>

            <div class="lb-product-card__body">
              <h3 class="lb-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="lb-product-card__price">{{ product.price | money }}</p>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="lb-text">Assign a featured collection to show products here.</p>
    {% endif %}
  </div>
</section>

<div class="lb-modal" data-lb-quick-modal>
  <div class="lb-modal__overlay" data-lb-modal-overlay></div>
  <div class="lb-modal__dialog" role="dialog" aria-modal="true" aria-label="Quick view product">
    <button class="lb-modal__close" type="button" data-lb-modal-close aria-label="Close modal">ï¿½</button>
    <div class="lb-modal__body">
      <img src="" alt="" data-lb-qv-image loading="lazy" style="width:100%; border-radius:12px; margin-bottom:0.9rem; aspect-ratio:4/3; object-fit:cover;" />
      <h3 data-lb-qv-title style="margin:0 0 0.45rem; color:var(--lb-charcoal);"></h3>
      <p data-lb-qv-price style="margin:0 0 0.95rem; color:var(--lb-muted);"></p>
      <a data-lb-qv-link class="lb-btn" href="#">View Product</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Home Boutique",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero eyebrow",
      "default": "Luxe Edit"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Curated Elegance for Your Every Moment"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero description",
      "default": "Discover premium perfumes, handcrafted jewelry, and elevated lifestyle selections designed for modern women."
    },
    {
      "type": "text",
      "id": "hero_cta_label",
      "label": "Hero CTA label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Hero CTA link"
    },
    {
      "type": "text",
      "id": "grid_title",
      "label": "Product grid title",
      "default": "Fresh In Store"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "grid_style",
      "label": "Grid style",
      "default": "clean",
      "options": [
        {
          "value": "clean",
          "label": "Clean grid"
        },
        {
          "value": "masonry",
          "label": "Masonry-style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Home Boutique"
    }
  ]
}
{% endschema %}


