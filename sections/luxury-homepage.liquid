{% liquid
  assign featured_collection = collections[section.settings.collection]
  assign arrivals_collection = collections[section.settings.new_arrivals_collection]
  assign perfumes_collection = collections[section.settings.perfumes_collection]
  assign jewelry_collection = collections[section.settings.jewelry_collection]
  assign garments_collection = collections[section.settings.garments_collection]
  assign lifestyle_collection = collections[section.settings.lifestyle_collection]
  assign products_to_show = section.settings.products_to_show
  assign hero_cta_link = section.settings.hero_cta_url
  if hero_cta_link == blank
    assign hero_cta_link = routes.all_products_collection_url
  endif
%}

<section class="lb-hero">
  <div class="lb-container">
    <div class="lb-hero__grid">
      <div class="lb-hero__image-wrap">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1800 | image_tag: class: 'lb-hero__image', loading: 'lazy', widths: '480, 768, 1024, 1440, 1800', sizes: '(max-width: 767px) 92vw, 56vw', alt: section.settings.hero_title }}
        {% else %}
          <img class="lb-hero__image" loading="lazy" src="{{ 'zareen-hero-ultra-hd.svg' | asset_url }}" alt="{{ section.settings.hero_title | escape }}">
        {% endif %}
      </div>
      <div class="lb-hero__content">
        <p class="lb-eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="lb-heading lb-hero__title">{{ section.settings.hero_title }}</h1>
        <p class="lb-text lb-hero__description">{{ section.settings.hero_text }}</p>
        <a class="lb-btn" href="{{ hero_cta_link }}">{{ section.settings.hero_cta_label }}</a>
      </div>
    </div>
  </div>
</section>

<section class="lb-featured-products">
  <div class="lb-container">
    <div class="lb-related__head">
      <div>
        <p class="lb-eyebrow">Curated Picks</p>
        <h2 class="lb-heading" style="margin:0.35rem 0 0; font-size: clamp(1.4rem, 4vw, 2rem);">{{ section.settings.grid_title }}</h2>
      </div>
      {% if featured_collection != blank %}
        <a class="lb-btn lb-btn--ghost" href="{{ featured_collection.url }}">Explore All</a>
      {% endif %}
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="lb-grid {% if section.settings.grid_style == 'masonry' %}lb-grid--masonry{% endif %}">
        {% for product in featured_collection.products limit: products_to_show %}
          {% render 'lb-product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="lb-text">Assign a featured collection to show products here.</p>
      <a class="lb-btn" href="{{ routes.all_products_collection_url }}" style="margin-top:0.7rem;">Browse All Products</a>
    {% endif %}
  </div>
</section>

<section class="lb-featured-products lb-new-arrivals">
  <div class="lb-container">
    <div class="lb-related__head">
      <div>
        <p class="lb-eyebrow">New Fashion</p>
        <h2 class="lb-heading" style="margin:0.35rem 0 0; font-size: clamp(1.4rem, 4vw, 2rem);">{{ section.settings.new_arrivals_title }}</h2>
      </div>
      {% if arrivals_collection != blank %}
        <a class="lb-btn lb-btn--ghost" href="{{ arrivals_collection.url }}">View New Arrivals</a>
      {% endif %}
    </div>

    {% if arrivals_collection != blank and arrivals_collection.products_count > 0 %}
      <div class="lb-grid lb-grid--masonry">
        {% for product in arrivals_collection.products limit: section.settings.new_arrivals_to_show %}
          {% render 'lb-product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="lb-text">Assign a collection in "New Arrivals collection" to showcase latest fashion drops.</p>
      <a class="lb-btn" href="{{ routes.all_products_collection_url }}" style="margin-top:0.7rem;">See All New Fashion</a>
    {% endif %}
  </div>
</section>

<section class="lb-home-categories">
  <div class="lb-container">
    <div class="lb-related__head">
      <div>
        <p class="lb-eyebrow">Shop Section Wise</p>
        <h2 class="lb-heading" style="margin:0.35rem 0 0; font-size: clamp(1.4rem, 4vw, 2rem);">{{ section.settings.categories_heading }}</h2>
      </div>
    </div>

    {% assign per_category = section.settings.category_products_to_show %}

    {% if perfumes_collection != blank %}
      <div class="lb-category-block">
        <div class="lb-category-block__head">
          <h3 class="lb-heading">{{ section.settings.perfumes_heading }}</h3>
          <a class="lb-btn lb-btn--ghost" href="{{ perfumes_collection.url }}">View All</a>
        </div>
        <div class="lb-grid">
          {% for product in perfumes_collection.products limit: per_category %}
            {% render 'lb-product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if jewelry_collection != blank %}
      <div class="lb-category-block">
        <div class="lb-category-block__head">
          <h3 class="lb-heading">{{ section.settings.jewelry_heading }}</h3>
          <a class="lb-btn lb-btn--ghost" href="{{ jewelry_collection.url }}">View All</a>
        </div>
        <div class="lb-grid">
          {% for product in jewelry_collection.products limit: per_category %}
            {% render 'lb-product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if garments_collection != blank %}
      <div class="lb-category-block">
        <div class="lb-category-block__head">
          <h3 class="lb-heading">{{ section.settings.garments_heading }}</h3>
          <a class="lb-btn lb-btn--ghost" href="{{ garments_collection.url }}">View All</a>
        </div>
        <div class="lb-grid">
          {% for product in garments_collection.products limit: per_category %}
            {% render 'lb-product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if lifestyle_collection != blank %}
      <div class="lb-category-block">
        <div class="lb-category-block__head">
          <h3 class="lb-heading">{{ section.settings.lifestyle_heading }}</h3>
          <a class="lb-btn lb-btn--ghost" href="{{ lifestyle_collection.url }}">View All</a>
        </div>
        <div class="lb-grid">
          {% for product in lifestyle_collection.products limit: per_category %}
            {% render 'lb-product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if perfumes_collection == blank and jewelry_collection == blank and garments_collection == blank and lifestyle_collection == blank %}
      <p class="lb-text">Assign at least one category collection to display section-wise products on the homepage.</p>
    {% endif %}
  </div>
</section>

<div class="lb-modal" data-lb-quick-modal>
  <div class="lb-modal__overlay" data-lb-modal-overlay></div>
  <div class="lb-modal__dialog" role="dialog" aria-modal="true" aria-label="Quick view product">
    <button class="lb-modal__close" type="button" data-lb-modal-close aria-label="Close modal">x</button>
    <div class="lb-modal__body">
      <img src="" alt="" data-lb-qv-image loading="lazy" style="width:100%; border-radius:12px; margin-bottom:0.9rem; aspect-ratio:4/3; object-fit:cover;" />
      <h3 data-lb-qv-title style="margin:0 0 0.45rem; color:var(--lb-charcoal);"></h3>
      <p data-lb-qv-price style="margin:0 0 0.95rem; color:var(--lb-muted);"></p>
      <a data-lb-qv-link class="lb-btn" href="#">View Product</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury Home Boutique",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero eyebrow",
      "default": "Luxe Edit"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Curated Elegance for Your Every Moment"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero description",
      "default": "Discover premium perfumes, handcrafted jewelry, and elevated lifestyle selections designed for modern women."
    },
    {
      "type": "text",
      "id": "hero_cta_label",
      "label": "Hero CTA label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "hero_cta_url",
      "label": "Hero CTA link"
    },
    {
      "type": "text",
      "id": "grid_title",
      "label": "Product grid title",
      "default": "Fresh In Store"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "text",
      "id": "new_arrivals_title",
      "label": "New arrivals section title",
      "default": "New Arrivals for Her"
    },
    {
      "type": "collection",
      "id": "new_arrivals_collection",
      "label": "New arrivals collection"
    },
    {
      "type": "range",
      "id": "new_arrivals_to_show",
      "label": "New arrivals to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Section-wise heading",
      "default": "Discover By Category"
    },
    {
      "type": "collection",
      "id": "perfumes_collection",
      "label": "Perfumes collection"
    },
    {
      "type": "text",
      "id": "perfumes_heading",
      "label": "Perfumes heading",
      "default": "Girls Perfumes"
    },
    {
      "type": "collection",
      "id": "jewelry_collection",
      "label": "Jewelry collection"
    },
    {
      "type": "text",
      "id": "jewelry_heading",
      "label": "Jewelry heading",
      "default": "Elegant Jewelry"
    },
    {
      "type": "collection",
      "id": "garments_collection",
      "label": "Garments collection"
    },
    {
      "type": "text",
      "id": "garments_heading",
      "label": "Garments heading",
      "default": "Fashion Garments"
    },
    {
      "type": "collection",
      "id": "lifestyle_collection",
      "label": "Lifestyle collection"
    },
    {
      "type": "text",
      "id": "lifestyle_heading",
      "label": "Lifestyle heading",
      "default": "Lifestyle Essentials"
    },
    {
      "type": "range",
      "id": "category_products_to_show",
      "label": "Products per category",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "grid_style",
      "label": "Grid style",
      "default": "clean",
      "options": [
        {
          "value": "clean",
          "label": "Clean grid"
        },
        {
          "value": "masonry",
          "label": "Masonry-style"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Home Boutique"
    }
  ]
}
{% endschema %}
